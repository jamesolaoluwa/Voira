# Voira frontend configuration.
# Copy this file to apps/web/.env and fill in real values.
# Every VITE_* value is public and baked into the build; never put secrets here.
# The filled-in .env is git-ignored and must never be committed.

# --- Required: Supabase ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- API ---
VITE_API_BASE_URL=http://localhost:8000   # production: https://voira-api.onrender.com
VITE_TRANSCRIPTION_WS_URL=                # optional; derived from the API URL if unset

# --- Billing (Stripe publishable/public values) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PRICE_ID_MONTHLY=price_...
VITE_STRIPE_PRICE_ID_YEARLY=price_...

# --- Error tracking (Sentry) ---
VITE_SENTRY_DSN=                          # optional
