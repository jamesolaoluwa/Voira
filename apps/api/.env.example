# Voira backend configuration.
# Copy this file to apps/api/.env and fill in real values.
# The filled-in .env is git-ignored and must never be committed.

# --- Required: Supabase (core infrastructure) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- Provider keys (required in production) ---
DEEPGRAM_API_KEY=your-deepgram-key        # live transcription
OPENAI_API_KEY=your-openai-key            # refinement + analysis

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# --- Error tracking (Sentry) ---
SENTRY_DSN=                               # required in production

# --- Runtime ---
ENV=development                           # development | staging | production
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # production: https://heyvoira.com
LOG_LEVEL=                                # defaults by environment if unset

# --- Rate limiting ---
REDIS_URL=                                # required in production; in-memory fallback locally

# --- Voira v1 model (LoRA essay adapter on Llama 3.1 8B) ---
VOIRA_MODEL_ENABLED=false                 # true routes essays through Voira v1
VOIRA_MODEL_URL=                          # local mlx server in dev; HF/Replicate endpoint in prod
VOIRA_MODEL_API_KEY=                      # provider token (not needed for the local mlx server)
