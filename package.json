{
  "name": "voira-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Voira monorepo: React frontend + FastAPI backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:api": "cd apps/api && .venv/bin/python -m uvicorn main:app --reload --port 8000",
    "dev": "npm run dev:api & npm run dev:web",
    "build:web": "cd apps/web && npm run build",
    "ci:scan": "cd apps/web && npm run ci:scan",
    "test:api": "cd apps/api && pytest -q",
    "lint:web": "cd apps/web && npm run lint"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}

